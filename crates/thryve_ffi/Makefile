# Makefile for the Thryve FFI example applications (GNU Make with gcc/g++, and a POSIX shell)
#
# Run it from crates/thryve_ffi:
#   make example-c      - Build the C example (builds the library first)
#   make example        - Build the C++ example
#   make all            - Build both
#   make install        - Copy the headers and the library to $(INSTALL_PREFIX) (default: dist)
#   make clean          - Remove the examples
#
#   make BUILD_TYPE=release example   - The same, against a release build of the library
#
# What `cargo build -p thryve_ffi` produces, in the workspace's target/debug/ or target/release/:
#   Windows:        thryve_ffi.dll, and its import library (thryve_ffi.dll.lib from the MSVC
#                   toolchain, libthryve_ffi.dll.a from the GNU one)
#   Linux / macOS:  libthryve_ffi.so / libthryve_ffi.dylib
# thryve_ffi.lib and libthryve_ffi.a are static libraries, which also need Rust's system
# libraries to link; these examples use the shared library. On Windows, gcc links the DLL itself,
# whichever toolchain built it.
#
# The headers (thryve.h and thryve_ffi.h) are generated by build.rs and copied to out/.

CARGO ?= cargo
CC = gcc
CXX = g++
BUILD_TYPE ?= debug
INSTALL_PREFIX ?= dist

# The workspace's target folder, and the profile's folder in it
TARGET_DIR ?= ../../target
LIB_DIR = $(TARGET_DIR)/$(BUILD_TYPE)
HEADER_DIR = out

ifeq ($(BUILD_TYPE),release)
    CARGO_FLAGS = --release
    OPT_FLAGS = -O2
endif

EXAMPLE_C = examples/main.c
EXAMPLE_CPP = examples/main.cpp

ifeq ($(OS),Windows_NT)
    EXE = .exe
    SHARED_LIB = $(LIB_DIR)/thryve_ffi.dll
    # gcc links the DLL itself; the DLL is copied next to each example, where Windows finds it.
    LINK = $(SHARED_LIB)
else
    EXE =
    ifeq ($(shell uname -s),Darwin)
        SHARED_LIB = $(LIB_DIR)/libthryve_ffi.dylib
    else
        SHARED_LIB = $(LIB_DIR)/libthryve_ffi.so
    endif
    # The library's folder is recorded in each example, where the loader finds it.
    LINK = -L$(LIB_DIR) -lthryve_ffi -Wl,-rpath,$(abspath $(LIB_DIR))
endif

# ============================================================
# Default target: both examples
# ============================================================
.PHONY: all
all: example-c example

# ============================================================
# Build the FFI library, and its headers (cargo build)
# ============================================================
.PHONY: build
build:
	$(CARGO) build $(CARGO_FLAGS) --package thryve_ffi

# ============================================================
# Build the C example
# ============================================================
.PHONY: example-c
example-c: build
	$(CC) -std=c11 $(OPT_FLAGS) -I$(HEADER_DIR) -o thryve_example_c$(EXE) $(EXAMPLE_C) $(LINK)
ifeq ($(OS),Windows_NT)
	cp $(SHARED_LIB) .
endif
	@echo "Built thryve_example_c$(EXE)"

# ============================================================
# Build the C++ example
# ============================================================
.PHONY: example
example: build
	$(CXX) -std=c++17 $(OPT_FLAGS) -I$(HEADER_DIR) -o thryve_example_cpp$(EXE) $(EXAMPLE_CPP) $(LINK)
ifeq ($(OS),Windows_NT)
	cp $(SHARED_LIB) .
endif
	@echo "Built thryve_example_cpp$(EXE)"

# ============================================================
# Install the headers and the library. On Windows, also the DLL's import library, for linkers
# that need one: MSVC's (renamed thryve_ffi.lib), or the GNU toolchain's.
# ============================================================
.PHONY: install
install: build
	mkdir -p $(INSTALL_PREFIX)/include $(INSTALL_PREFIX)/lib
	cp $(HEADER_DIR)/thryve.h $(HEADER_DIR)/thryve_ffi.h $(INSTALL_PREFIX)/include/
ifeq ($(OS),Windows_NT)
	mkdir -p $(INSTALL_PREFIX)/bin
	cp $(SHARED_LIB) $(INSTALL_PREFIX)/bin/
	if [ -f $(LIB_DIR)/thryve_ffi.dll.lib ]; then \
	    cp $(LIB_DIR)/thryve_ffi.dll.lib $(INSTALL_PREFIX)/lib/thryve_ffi.lib; \
	else \
	    cp $(LIB_DIR)/libthryve_ffi.dll.a $(INSTALL_PREFIX)/lib/; \
	fi
else
	cp $(SHARED_LIB) $(INSTALL_PREFIX)/lib/
endif
	@echo "Installed to $(INSTALL_PREFIX)"

# ============================================================
# Clean: the examples only; `cargo clean` cleans the library
# ============================================================
.PHONY: clean
clean:
	rm -f thryve_example_c$(EXE) thryve_example_cpp$(EXE)
ifeq ($(OS),Windows_NT)
	rm -f thryve_ffi.dll
endif

# ============================================================
# Display help
# ============================================================
.PHONY: help
help:
	@echo "Thryve FFI examples"
	@echo ""
	@echo "Targets:"
	@echo "  make example-c   - Build the C example (and the library)"
	@echo "  make example     - Build the C++ example (and the library)"
	@echo "  make all         - Build both examples"
	@echo "  make install     - Copy the headers and the library to INSTALL_PREFIX (default: dist)"
	@echo "  make clean       - Remove the examples"
	@echo ""
	@echo "Options:"
	@echo "  BUILD_TYPE=release   - Use a release build of the library"
	@echo "  TARGET_DIR=<path>    - Cargo's target folder (default: ../../target)"
